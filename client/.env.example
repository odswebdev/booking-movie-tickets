# Full URL of the API. Leave unset to use the same origin via "/api"
# (the Vite dev server proxies /api to http://localhost:4000).
VITE_API_URL=

# Deployment base path. GitHub Pages project sites need "/movie-tickets/".
# Any other host (Vercel, Netlify, custom domain, Docker) should use "/".
VITE_BASE=/movie-tickets/
