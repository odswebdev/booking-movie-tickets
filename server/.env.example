# Runtime environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Comma separated allow-list of browser origins. Use "*" only in development.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=
# Any unit works: 30s, 15m, 1h, 7d (parsed for you, no more NaN expiries)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# A rotated refresh token replayed inside this window is treated as a two-tab
# race (re-rotates) instead of a theft that logs the user out everywhere.
REFRESH_REUSE_GRACE_MS=60000

# Passwordless sign-in: the magic link emailed by POST /api/auth/magic-link
# stays valid for this many minutes (single use).
MAGIC_LINK_TTL_MINUTES=15
# Guest checkout mints a token scoped to one booking; this is its lifetime.
# The guest account can later be claimed with a password (POST /api/auth/guest/claim).
GUEST_TOKEN_TTL_HOURS=72

# Where the JSON datastore is written (relative paths are allowed)
DATA_DIR=./data

# --------------------------------------------------------------------------
# Transactional store. Blank = zero-config JSON file + in-memory seat holds.
# Set DATABASE_URL for Postgres (Prisma) and REDIS_URL for seat holds/events;
# each falls back independently (Postgres unreachable → JSON, Redis down →
# in-memory). Compose: DATABASE_URL=postgresql://cinetickets:cinetickets@postgres:5432/cinetickets
# --------------------------------------------------------------------------
DATABASE_URL=
REDIS_URL=

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --------------------------------------------------------------------------
# Observability (ТЗ §1.7). Prometheus-style registry in-process:
# GET /api/metrics (text exposition), /api/metrics/summary, /api/metrics/alerts.
# METRICS_ENABLED=false hides all three; METRICS_TOKEN requires a bearer token.
# The alert evaluator diffs the registry every ALERT_EVAL_INTERVAL_MS and fires
# threshold rules (payment failure rate, HTTP error rate, 401/min, latency p95,
# seat conflicts, SMS quota, queue failures, open circuit breakers). A fired
# alert is logged and optionally POSTed to ALERT_WEBHOOK_URL (Slack/Telegram-
# style JSON). Each rule carries its own cooldown so incidents do not spam.
# --------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_TOKEN=
ALERTS_ENABLED=true
ALERT_EVAL_INTERVAL_MS=30000
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=3000
ALERT_PAYMENT_FAILURE_RATE=0.25
ALERT_HTTP_ERROR_RATE=0.05
ALERT_AUTH_401_PER_MINUTE=30
ALERT_LATENCY_P95_MS=1500
ALERT_SEAT_CONFLICTS_PER_MINUTE=30
ALERT_SMS_QUOTA_HITS=10
ALERT_NOTIFICATION_FAILURES=5
ALERT_QUEUE_FAILURES=5
ALERT_MIN_HTTP_SAMPLES=20
ALERT_MIN_PAYMENT_SAMPLES=5

# Set to true when running behind a reverse proxy (nginx, Render, Fly)
TRUST_PROXY=false

# Serve the built client from the API process (single-container deployment)
SERVE_CLIENT=false

# Rate limits (per 15 minute window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
PAYMENT_RATE_LIMIT_MAX=40

# --------------------------------------------------------------------------
# Catalog provider (optional): The Movie Database
# Without a key the bundled catalogue (6 movies, EN + RU) is used.
# With a key, "now playing" movies are streamed with real posters,
# overviews, release dates and ratings, cached for TMDB_CACHE_TTL_MS.
# Key: https://www.themoviedb.org/settings/api
# --------------------------------------------------------------------------
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
TMDB_REGION=US
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
TMDB_CACHE_TTL_MS=21600000
TMDB_TIMEOUT_MS=5000

# Booking window: how many days ahead the schedule is published
# (ТЗ §5: the 14-day calendar). 1–30.
CATALOG_WINDOW_DAYS=14

# --------------------------------------------------------------------------
# SMS gateway for payment confirmation codes (6 digits, 5-minute TTL,
# 3 attempts, max SMS_MAX_PER_HOUR per phone number).
# mock: logged locally, refused in production. generic: any HTTP gateway
# (POST { "to", "text", "from" }, Bearer $SMS_PROVIDER_TOKEN when set).
# Unset SMS_PROVIDER = generic when SMS_PROVIDER_URL is set, else mock.
# --------------------------------------------------------------------------
SMS_PROVIDER=mock
SMS_MAX_PER_HOUR=5
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_PROVIDER_TIMEOUT_MS=5000
SMS_FROM=CineTickets

# sms.ru: API id from https://sms.ru/api
SMSRU_API_ID=
# SMSC.ru: login + password (an API key works as the password)
SMSC_LOGIN=
SMSC_PASSWORD=
# Twilio: https://www.twilio.com/console (sender number in E.164)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --------------------------------------------------------------------------
# Email for tickets/receipts (QR + PDF receipt attached).
# mock: in-memory outbox, refused in production. smtp: any relay.
# sendgrid: Web API. Unset EMAIL_PROVIDER = sendgrid when the API key is set,
# smtp when SMTP_HOST is set, else mock.
# --------------------------------------------------------------------------
EMAIL_PROVIDER=mock
EMAIL_FROM=CineTickets <no-reply@cinetickets.example>

# SMTP relay (Mailpit for local dev: SMTP_HOST=localhost SMTP_PORT=1025)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=10000

# SendGrid: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# --------------------------------------------------------------------------
# Background jobs (BullMQ + Redis): sms, email, pdf queues.
# auto = inline in tests, BullMQ when REDIS_URL is set, else inline
# (zero infrastructure — the API runs the same pipeline in-process).
# Run the worker with: npm run worker -w @movie-tickets/server
# --------------------------------------------------------------------------
QUEUES_DRIVER=auto

# Currency conversion from the base currency (USD cents).
# UI language picks the currency: English = USD, Russian = RUB.
FX_RATES=RUB:90,USD:1

# Promo codes as CODE:percent pairs. A volume discount (4+ seats 10%,
# 6+ seats 15%) is applied automatically; movies may carry their own
# discountPercent too — the best single offer always wins.
PROMO_CODES=WELCOME10:10,CINEMA20:20,STUDENT15:15

# Loyalty (ТЗ §2: BonusTransaction / Referral). Every succeeded payment earns
# BONUS_PERCENT of its total as bonus cents; a signup with a referral code
# credits the new user and the inviter once (first payment of the referred).
BONUS_PERCENT=5
REFERRAL_WELCOME_BONUS_CENTS=300
REFERRAL_INVITER_BONUS_CENTS=500

# --------------------------------------------------------------------------
# Payments. `mock` settles every charge instantly (local dev, CI).
# Card PSP: yookassa (МИР, СБП) or stripe (Visa/Mastercard).
# PayPal is used automatically for the PayPal method when its credentials set.
# Public base URL of the web client (PSP return/approval redirects).
# --------------------------------------------------------------------------
PAYMENTS_PROVIDER=mock
APP_PUBLIC_URL=http://localhost:5173

# YooKassa sandbox: https://yookassa.ru/developers/payment-acceptance/testing-and-going-live/testing
# Test cards from the docs; webhooks have no signature — every event is
# re-confirmed with an authenticated GET /payments/{id}.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3

# Stripe test mode: secret key (sk_test_...) + webhook signing secret (whsec_...).
# Test cards: 4242 4242 4242 4242 (success), 4000 0027 6000 3184 (3DS),
# 4000 0000 0000 0002 (decline). Local webhooks: `stripe listen --forward-to localhost:4000/api/webhooks/stripe`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_URL=https://api.stripe.com

# --------------------------------------------------------------------------
# PCI-safe card widgets (ТЗ §5–6) instead of the raw PAN form.
# auto: mount the provider widget when its public key is set, else the
# encrypted embedded form; embedded: always the raw form; yookassa/stripe:
# force one widget. Keys are public by design (Checkout.js / PaymentElement).
# --------------------------------------------------------------------------
CARD_WIDGET=auto
YOOKASSA_PUBLIC_KEY=
STRIPE_PUBLISHABLE_KEY=

# PayPal sandbox REST app: https://developer.paypal.com/dashboard/applications/sandbox
# Webhook id from the sandbox webhook simulator; events are verified via
# PayPal's verify-webhook-signature API.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# --------------------------------------------------------------------------
# IP geolocation for the default city on /cinemas (GET /api/geo).
# mock: deterministic New York (dev, tests). ipapi: keyless ipapi.co JSON.
# sypex: keyless api.sypexgeo.net (RU-friendly). maxmind: local GeoLite2 DB.
# Unset GEO_PROVIDER = maxmind when GEO_MMDB_PATH is set, else mock.
# Private IPs never leave the box; every failure falls back to NYC.
# --------------------------------------------------------------------------
GEO_PROVIDER=mock
GEO_MMDB_PATH=
GEO_TIMEOUT_MS=3000

# --------------------------------------------------------------------------
# Analytics (ТЗ §10): GA4 + Yandex.Metrica loaded through Google Tag Manager.
# The ids are served to the client via GET /api/config — no client rebuild
# needed, and an empty GTM_ID simply loads no tags. Funnel events
# (view_movie … payment_failed) go to dataLayer; UTM tags are captured on the
# client, sent as X-Utm and stored in AuditLog.meta.utm.
# --------------------------------------------------------------------------
GTM_ID=
GA4_ID=
YM_ID=
